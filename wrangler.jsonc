{
  "name": "bwog",
  "main": "./cloudflare/worker.js",
  "upload_source_maps": true,
  "compatibility_date": "2026-11-11",
  "keep_vars": true,
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "DATABASE",
        "class_name": "Database"
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "STORE",
      "bucket_name": "blog-public"
    },
    {
      "binding": "PRIVATE_BUCKET",
      "bucket_name": "blog-private"
    }
  ],
  "exports": {
    "Database": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}